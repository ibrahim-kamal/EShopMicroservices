{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**Catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "basket": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket/{**Catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "order": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/{**Catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destinations1": {
            "Address": "http://localhost:6000"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "destinations1": {
            "Address": "http://localhost:6001"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destinations1": {
            "Address": "http://localhost:6003"
          }
        }
      }

    }
  }
}
